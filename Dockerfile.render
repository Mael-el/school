FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
    tini \
    xvfb \
    xauth \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --include=dev --fetch-retries=5 --fetch-timeout=300000 \
  && ./node_modules/.bin/install-electron \
  && chown -R node:node node_modules \
  && chown node:node /app

COPY --chown=node:node . .

USER node

RUN npm run web:build && npm run render:build-electron

CMD ["tini", "--", "xvfb-run", "-a", "./node_modules/electron/dist/electron", "--no-sandbox", ".vite/build/main.js"]
